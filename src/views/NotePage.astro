---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/ui/Icon.astro';
import { formatDate, htmlLang, localePath, t, tr, type Locale } from '~/i18n';
import { getFacts, getNotes, noteSlug } from '~/lib/content';
import { blogPath, categoryLabel, categoryPath } from '~/lib/blog';

interface Props {
  lang: Locale;
  note: CollectionEntry<'notes'>;
  /** Locales in which this note exists, for hreflang and the language switch. */
  alternates: Locale[];
}
const { lang, note, alternates } = Astro.props;
const _ = t(lang);
const { Content, headings } = await render(note);
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const other = alternates.find((l) => l !== lang);
const notes = await getNotes(lang);
const position = notes.findIndex((n) => n.id === note.id);
const older = position >= 0 ? notes[position + 1] : undefined;
const newer = position > 0 ? notes[position - 1] : undefined;
const url = new URL(localePath(lang, blogPath(noteSlug(note))), Astro.site).href;
const author = tr((await getFacts()).get('identity.name')?.text, lang);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: note.data.title, description: note.data.description,
  datePublished: note.data.date.toISOString(),
  dateModified: (note.data.updated ?? note.data.date).toISOString(),
  url, mainEntityOfPage: url, inLanguage: htmlLang[lang],
  articleSection: categoryLabel(note.data.category, lang),
  ...(author ? { author: { '@type': 'Person', name: author, url: new URL('/', Astro.site).href } } : {}),
  ...(note.data.tags.length ? { keywords: note.data.tags } : {}),
};
const labels = lang === 'zh'
  ? { contents: '目录', tags: '标签', older: '上一篇', newer: '下一篇', articles: '文章导航' }
  : { contents: 'On this page', tags: 'Tags', older: 'Older article', newer: 'Newer article', articles: 'Article navigation' };
---

<Base lang={lang} title={note.data.title} description={note.data.description} type="article" alternates={alternates}>
  <Fragment slot="head">
    <meta property="article:published_time" content={note.data.date.toISOString()} />
    <meta property="article:modified_time" content={(note.data.updated ?? note.data.date).toISOString()} />
    <meta property="article:section" content={categoryLabel(note.data.category, lang)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <article class="note container" data-visibility={note.data.visibility}>
    <a class="back mono" href={localePath(lang, '/blog/')}><Icon name="arrow-left" size={14} /> {_('notes.back')}</a>
    <header>
      <a class="category mono" href={localePath(lang, categoryPath(note.data.category))}>{categoryLabel(note.data.category, lang)}</a>
      <p class="mono date">
        <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date, lang)}</time>
        {
          note.data.updated && (
            <span class="faint">
              · {_('notes.updated')} {formatDate(note.data.updated, lang)}
            </span>
          )
        }
      </p>
      <h1>{note.data.title}</h1>
      <p class="lede">{note.data.description}</p>
      {note.data.tags.length > 0 && <ul class="tags" role="list" aria-label={labels.tags}>{note.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
      {
        other && (
          <p class="other mono">
            <a href={localePath(other, blogPath(noteSlug(note)))} hreflang={htmlLang[other]}>
              {_('notes.otherLang')}
            </a>
          </p>
        )
      }
    </header>
    {outline.length > 0 && (
      <details class="outline" open>
        <summary>{labels.contents}</summary>
        <nav aria-label={labels.contents}>
          <ol role="list">
            {outline.map((heading) => <li class:list={[heading.depth === 3 && 'subheading']}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </nav>
      </details>
    )}
    <div class="prose">
      <Content />
    </div>
    {(older || newer) && (
      <nav class="adjacent" aria-label={labels.articles}>
        {older && <a href={localePath(lang, blogPath(noteSlug(older)))} rel="prev"><span class="mono">{labels.older}</span><span>{older.data.title}</span></a>}
        {newer && <a href={localePath(lang, blogPath(noteSlug(newer)))} rel="next"><span class="mono">{labels.newer}</span><span>{newer.data.title}</span></a>}
      </nav>
    )}
  </article>
</Base>

<style>
  .note {
    max-width: 46rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .back {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
    text-transform: none;
  }
  header {
    margin-block: 2.5rem 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .date {
    color: var(--accent);
    text-transform: none;
    margin-top: 0.75rem;
  }
  .category { color: var(--accent); text-decoration: none; text-transform: none; }
  h1 {
    font-size: var(--step-4);
    margin-top: 0.75rem;
  }
  .lede {
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .other {
    margin-top: 1rem;
    text-transform: none;
  }
  .other a {
    color: var(--accent);
    text-decoration: none;
  }
  .prose {
    font-size: var(--step-0);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; padding: 0; }
  .tags li { border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.65rem; color: var(--text-muted); font-size: var(--step--1); }
  .outline { border-block: 1px solid var(--line); padding-block: 1rem; margin-bottom: 2.5rem; }
  .outline summary { color: var(--text-muted); cursor: pointer; }
  .outline ol { padding: 1rem 0 0; display: grid; gap: 0.55rem; }
  .outline .subheading { padding-left: 1rem; }
  .outline a { color: var(--text-muted); text-decoration: none; }
  .outline a:hover { color: var(--accent); }
  .adjacent { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1.5rem; }
  .adjacent a { display: grid; align-content: start; gap: 0.75rem; text-decoration: none; }
  .adjacent .mono { color: var(--text-faint); text-transform: none; }
  .adjacent a[rel='next'] { grid-column: 2; text-align: right; }
  .prose :global(:is(p, ul, ol, blockquote, pre, figure)) {
    margin-block: 0 1.25em;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin-block: 2.2em 0.8em;
  }
  .prose :global(h3) {
    font-size: var(--step-1);
    margin-block: 1.8em 0.6em;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-block: 0.35em;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--accent);
    font-weight: 600;
  }
  .prose :global(blockquote) {
    padding-left: 1.2em;
    border-left: 2px solid var(--accent);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-deep);
    overflow-x: auto;
    font-size: var(--step--1);
    max-width: 100%;
  }
  .prose :global(pre.astro-code), .prose :global(pre.astro-code span) { color: var(--shiki-light); background-color: var(--shiki-light-bg); }
  :global(:root[data-theme='night']) .prose :global(pre.astro-code),
  :global(:root[data-theme='night']) .prose :global(pre.astro-code span) { color: var(--shiki-dark); background-color: var(--shiki-dark-bg); }
  .prose :global(table) { display: block; width: max-content; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 1.5rem; }
  .prose :global(:is(th, td)) { padding: 0.6rem 0.9rem; border: 1px solid var(--line); text-align: start; overflow-wrap: normal; }
  .prose :global(th) { color: var(--text); background: var(--surface); }
  .prose :global(.katex-display) { overflow-x: auto; overflow-y: hidden; padding-block: 0.5rem; }
  .prose :global(:is(h2, h3, h4, [id^='user-content-fn'])) { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--surface-2);
  }
  .prose :global(img) {
    border-radius: var(--radius);
    height: auto;
    max-width: 100%;
  }
  @media (max-width: 35rem) {
    .adjacent { gap: 1rem; }
  }
  @media print {
    .back, .outline, .adjacent, .other { display: none; }
    .prose :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
    .prose :global(table) { display: table; width: 100%; font-size: 0.85em; }
    .prose :global(.katex-display) { overflow: visible; }
  }
</style>
