---
/** Shown by production builds until the owner approves at least their name. */
import Logo from '~/components/ui/Logo.astro';
import { site } from '~/config/site';
import { t, type Locale } from '~/i18n';

interface Props {
  lang: Locale;
}
const _ = t(Astro.props.lang);
---

<section class="soon">
  <canvas class="sky" data-sky aria-hidden="true"></canvas>
  <div class="center">
    <Logo size={56} />
    <h1>{site.domain}</h1>
    <p class="mono">{_('soon.title')}</p>
    <p class="muted">{_('soon.body')}</p>
  </div>
</section>

<script>
  import { mountSky } from '~/scripts/sky';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-sky]');
  if (canvas) mountSky(canvas, { radiant: { x: 0.5, y: 0.32 }, rate: 1100 });
</script>

<style>
  .soon {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(60% 50% at 50% 32%, var(--accent-soft), transparent 70%), var(--bg-deep);
  }
  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .center {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    padding: 2rem;
  }
  h1 {
    font-size: var(--step-4);
    margin-top: 1rem;
  }
  .mono {
    color: var(--accent);
  }
</style>
