---
/** The radiant mark: a star with three meteors streaking away from it. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
// Header and footer both draw the mark on every page: each instance needs its own gradient id.
const trail = `logo-trail-${size}`;
---

<svg class:list={['logo', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id={trail} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <g stroke={`url(#${trail})`} stroke-width="1.6" stroke-linecap="round" fill="none">
    <path d="M19.5 12.5 6 26"></path>
    <path d="M17.5 9.5 5.5 15.5"></path>
    <path d="M22.5 14.5 16.5 27"></path>
  </g>
  <path class="logo-star" d="M23 3.5 24.4 7.6 28.5 9 24.4 10.4 23 14.5 21.6 10.4 17.5 9 21.6 7.6Z"></path>
</svg>

<style>
  .logo {
    color: var(--text);
  }
  .logo-star {
    fill: var(--accent);
    filter: drop-shadow(0 0 3px var(--glow));
  }
</style>
