---
/**
 * The atlas: a star chart of Aries. Research themes are the stars of the figure that have public
 * work; each work is a small star on its theme's orbit. Lines, orbits and the graticule are SVG;
 * stars and labels are HTML placed in percentages, so they stay legible at any width.
 *
 * Interaction: theme stars and the panel's theme list are the same filter (`work:filter` events);
 * hovering a star shows it in the panel. Work stars are mouse shortcuts only; their keyboard path
 * is the card grid below, so the chart never adds tiny focus targets.
 *
 * Every panel state (resting, each theme, each work) is rendered up front and stacked in one grid
 * cell, so the panel is always as tall as its longest state and hovering never moves the page.
 * Lines on the chart are knocked out under labels, as on a printed chart (see knockout()).
 */
import type { Chart } from '~/lib/aries';
import Typeset from '~/components/ui/Typeset.astro';
import { t, type Locale } from '~/i18n';
import { script } from '~/lib/typeset';

interface Props {
  lang: Locale;
  chart: Chart;
  /** Number of cards per theme, for the filter list. */
  counts: Record<string, number>;
  total: number;
}
const { lang, chart, counts, total } = Astro.props;
const _ = t(lang);
const other: Locale = lang === 'zh' ? 'en' : 'zh';
const { w, h } = chart;
const pct = (p: { x: number; y: number }) => `left:${((p.x / w) * 100).toFixed(3)}%;top:${((p.y / h) * 100).toFixed(3)}%`;
const lit = chart.stars.filter((s) => s.theme);
const themeStar = new Map(lit.map((s) => [s.theme!.id, s]));
// Apparent size from magnitude: Hamal (2.0) is the largest; 5.6 is a speck.
const size = (mag: number) => Math.max(1.6, 9.5 - mag * 1.45);
const designation = (s: { bayer: string; name?: string | undefined }) => s.bayer + (s.name ? ` · ${s.name}` : '');
// Rays around the radiant, in chart units. They are HTML rather than SVG so their flicker runs on
// the compositor; knockout() masks them under labels like the SVG lines.
const rays = Array.from({ length: 12 }, (_, i) => {
  const r1 = 24 + (i % 3) * 5;
  return { a: (i / 12) * Math.PI * 2 + 0.2, r1, len: 14 + (i % 2) * 10, d: ((i * 7) % 12) * 0.45 };
});
---

<figure class="atlas" data-atlas data-loops aria-label={_('atlas.label')}>
  <div class="chart rim" style={`aspect-ratio:${w}/${h};--u:calc(100cqw / ${w})`} data-chart>
    <svg class="lines" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs>
        <radialGradient id="atlas-vignette" cx="50%" cy="45%" r="70%">
          <stop offset="0" class="vg-in"></stop>
          <stop offset="1" class="vg-out"></stop>
        </radialGradient>
        {/* Holes under the labels, measured in the browser; without script it masks nothing. */}
        <mask id="atlas-ko" maskUnits="userSpaceOnUse" x="0" y="0" width={w} height={h}>
          <rect width={w} height={h} fill="white"></rect>
          <g data-ko fill="black"></g>
        </mask>
      </defs>
      <rect width={w} height={h} fill="url(#atlas-vignette)"></rect>
      <g mask="url(#atlas-ko)">
      <g class="grat">
        {chart.graticule.map((g) => <path d={g.d} class={g.kind} vector-effect="non-scaling-stroke" />)}
      </g>
      <g class="figure">
        {
          chart.figure.map((f, i) => (
            <line
              x1={f.x1}
              y1={f.y1}
              x2={f.x2}
              y2={f.y2}
              class:list={['fig', { lit: f.lit }]}
              style={`--i:${i}`}
              pathLength="1"
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </g>
      <g class="orbits">
        {
          lit.map((s) => (
            <circle cx={s.x} cy={s.y} r={s.theme!.orbit} class="orbit" data-orbit={s.theme!.id} vector-effect="non-scaling-stroke" />
          ))
        }
      </g>
      <g class="links">
        {
          chart.works.flatMap((wk) =>
            wk.secondary.map((th) => {
              const s = themeStar.get(th)!;
              return (
                <line
                  x1={s.x}
                  y1={s.y}
                  x2={wk.x}
                  y2={wk.y}
                  class="also"
                  data-from={`theme:${th}`}
                  data-to={`work:${wk.id}`}
                  vector-effect="non-scaling-stroke"
                />
              );
            }),
          )
        }
      </g>
      <g class="radiant" transform={`translate(${chart.radiant.x} ${chart.radiant.y})`}>
        <circle r="9" class="rad-ring"></circle>
        <circle r="17" class="rad-ring dashed"></circle>
      </g>
      </g>
    </svg>

    <span class="rays" style={pct(chart.radiant)} aria-hidden="true" data-rays>
      {rays.map((r) => <span class="ray" style={`--a:${r.a.toFixed(3)}rad;--r1:${r.r1};--len:${r.len};--d:${r.d.toFixed(2)}s`} />)}
    </span>

    {/* Field and figure stars without a public theme: drawn, never interactive. */}
    {
      chart.stars
        .filter((s) => !s.theme)
        .map((s, i) => (
          <span class:list={['fstar', { fig: s.inFigure }]} style={`${pct(s)};--s:${size(s.mag)}px;--tw:${(i % 5) * 0.9}s`} aria-hidden="true">
            {s.inFigure && <span class="bayer">{s.bayer}</span>}
          </span>
        ))
    }

    <span class="rad-label label" style={pct(chart.radiant)} aria-hidden="true">{_('atlas.radiant')}</span>

    {
      chart.works.map((wk) => (
        <span
          class="wstar"
          style={pct(wk)}
          data-node={`work:${wk.id}`}
          data-theme-id={wk.theme}
          data-secondary={wk.secondary.join(' ')}
          data-href={wk.href}
          data-visibility={wk.visibility}
          aria-hidden="true"
        >
          <span class="core" />
        </span>
      ))
    }

    {
      lit.map((s) => (
        <button
          type="button"
          class="tstar"
          style={`${pct(s)};--s:${size(s.mag)}px`}
          data-node={`theme:${s.theme!.id}`}
          data-theme-id={s.theme!.id}
          data-side={s.theme!.side}
          data-side-short={s.theme!.sideShort}
          aria-pressed="false"
        >
          <span class="core" aria-hidden="true" />
          <span class="tlabel">
            <span class="tname">
              <span class="full">{s.theme!.label}</span>
              <span class="short">
                {s.theme!.short}
                <span class="sr-only"> ({s.theme!.label})</span>
              </span>
            </span>
            <span class="tbayer data">{designation(s)}</span>
          </span>
        </button>
      ))
    }

    <span class="corner tl label" aria-hidden="true">
      {_('atlas.constellation')}
      <span lang={other === 'zh' ? 'zh-CN' : 'en'}>{t(other)('atlas.constellation')}</span>
    </span>
    <span class="corner br data" aria-hidden="true">RA 01h–03h · Dec +15°–+30°</span>
  </div>

  <figcaption class="panel rim">
    <div class="detail" data-panel>
      <div class="state rest on" data-state="">
        <p class="p-meta label">{_('atlas.label')}</p>
        <p class="p-title">{_('atlas.constellation')}</p>
        <p class="p-summary">{_('atlas.hintShort')}</p>
        <ul class="legend label" role="list" aria-hidden="true">
          <li><span class="lg theme"></span>{_('atlas.legend.theme')}</li>
          <li><span class="lg work"></span>{_('atlas.legend.work')}</li>
          <li><span class="lg also"></span>{_('atlas.legend.secondary')}</li>
          <li><span class="lg rad"></span>{_('atlas.radiant')}</li>
        </ul>
      </div>
      {
        lit.map((s) => (
          <div class="state" data-state={`theme:${s.theme!.id}`}>
            <p class="p-meta designation">{designation(s)}</p>
            <p class="p-title" data-script={script(s.theme!.label)}>
              {s.theme!.label}
            </p>
            {s.theme!.blurb && (
              <p class="p-summary">
                <Typeset text={s.theme!.blurb} />
              </p>
            )}
          </div>
        ))
      }
      {
        chart.works.map((wk) => (
          <div class="state" data-state={`work:${wk.id}`} data-visibility={wk.visibility}>
            <p class="p-meta label">
              {wk.meta.split(' · ').map((part, i) => (
                <>
                  {i > 0 && ' · '}
                  <span class="nobr">{part}</span>
                </>
              ))}
            </p>
            <p class="p-title" data-script={script(wk.label)} lang={lang === 'zh' && script(wk.label) === 'latin' ? 'en' : undefined}>
              <Typeset text={wk.label} split />
            </p>
            {wk.summary && (
              <p class="p-summary">
                <Typeset text={wk.summary} />
              </p>
            )}
          </div>
        ))
      }
    </div>

    <p class="sr-only" role="status" data-filter-status data-template={_('filter.status')}></p>
    <div class="filters" role="group" aria-label={_('filter.label')} data-filters>
      <button type="button" class="filter" aria-pressed="true" data-filter="">
        <span class="f-dot all" aria-hidden="true"></span>
        <span class="f-name">{_('filter.all')}</span>
        <span class="f-count data">{total}</span>
      </button>
      {
        lit
          .filter((s) => counts[s.theme!.id])
          .map((s) => (
            <button type="button" class="filter" aria-pressed="false" data-filter={s.theme!.id}>
              <span class="f-dot" aria-hidden="true" />
              <span class="f-name">
                {s.theme!.label}
                <span class="f-bayer data">{s.bayer}</span>
              </span>
              <span class="f-count data">{counts[s.theme!.id]}</span>
            </button>
          ))
      }
    </div>
  </figcaption>
</figure>

<script>
  import { isStill } from '~/scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-atlas]').forEach((atlas) => {
    const tstars = [...atlas.querySelectorAll<HTMLButtonElement>('.tstar')];
    const wstars = [...atlas.querySelectorAll<HTMLElement>('.wstar')];
    const filters = [...atlas.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const links = [...atlas.querySelectorAll<SVGLineElement>('line.also')];
    const orbits = [...atlas.querySelectorAll<SVGCircleElement>('[data-orbit]')];
    const states = [...atlas.querySelectorAll<HTMLElement>('[data-state]')];
    const rail = atlas.querySelector<HTMLElement>('[data-filters]');
    const words = (v: string | undefined) => (v ?? '').split(' ').filter(Boolean);
    let pinned: string | null = null;

    /** Light one theme (and its works), or one work (and its themes); null is the resting chart. */
    function light(target: { theme?: string | null; work?: HTMLElement } | null) {
      atlas.toggleAttribute('data-focus', !!(target?.theme || target?.work));
      const work = target?.work;
      const theme = target?.theme ?? work?.dataset.themeId ?? null;
      const extra = new Set(words(work?.dataset.secondary));
      tstars.forEach((s) => s.classList.toggle('lit', s.dataset.themeId === theme || extra.has(s.dataset.themeId!)));
      wstars.forEach((s) =>
        s.classList.toggle('lit', work ? s === work : !!theme && (s.dataset.themeId === theme || words(s.dataset.secondary).includes(theme))),
      );
      orbits.forEach((o) => o.classList.toggle('lit', !!theme && o.dataset.orbit === theme));
      links.forEach((l) => l.classList.toggle('lit', work ? l.dataset.to === work.dataset.node : !!theme && l.dataset.from === `theme:${theme}`));
    }
    /** Light the target and show its state in the panel. */
    function show(target: { theme?: string | null; work?: HTMLElement } | null) {
      light(target);
      const key = target?.work ? target.work.dataset.node! : target?.theme ? `theme:${target.theme}` : '';
      states.forEach((el) => el.classList.toggle('on', el.dataset.state === key));
    }
    const rest = () => show(pinned ? { theme: pinned } : null);

    function sync(theme: string | null) {
      pinned = theme;
      tstars.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.themeId === theme)));
      filters.forEach((f) => f.setAttribute('aria-pressed', String((f.dataset.filter || null) === theme)));
      rest();
      // On the chip rail, bring the pressed chip into view (sideways only, never moving the page).
      const on = filters.find((f) => f.getAttribute('aria-pressed') === 'true');
      if (rail && on && rail.scrollWidth > rail.clientWidth + 1) {
        const r = on.getBoundingClientRect();
        const rr = rail.getBoundingClientRect();
        if (r.left < rr.left + 4 || r.right > rr.right - 40) {
          rail.scrollBy({ left: r.left - rr.left - 12, behavior: isStill() ? 'auto' : 'smooth' });
        }
      }
    }
    const status = atlas.querySelector<HTMLElement>('[data-filter-status]');
    function choose(theme: string | null) {
      sync(theme);
      document.dispatchEvent(new CustomEvent('work:filter', { detail: theme }));
      // Say how many items the filter leaves, once per choice (hover never announces).
      const f = filters.find((x) => (x.dataset.filter || null) === theme);
      if (status && f) {
        const name = f.querySelector('.f-name')?.firstChild?.textContent?.trim() ?? '';
        const n = f.querySelector('.f-count')?.textContent?.trim() ?? '';
        status.textContent = (status.dataset.template ?? '').replace('{theme}', name).replace('{n}', n);
      }
    }

    for (const s of tstars) {
      s.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && show({ theme: s.dataset.themeId }));
      s.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && rest());
      s.addEventListener('focus', () => show({ theme: s.dataset.themeId }));
      s.addEventListener('blur', rest);
      s.addEventListener('click', () => choose(pinned === s.dataset.themeId ? null : s.dataset.themeId!));
    }
    for (const s of wstars) {
      s.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && show({ work: s }));
      s.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && rest());
      s.addEventListener('click', () => s.dataset.href && (location.href = s.dataset.href));
    }
    for (const f of filters) {
      f.addEventListener('focus', () => f.scrollIntoView({ block: 'nearest', inline: 'nearest' }));
      f.addEventListener('click', () => choose(f.dataset.filter || null));
      f.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && f.dataset.filter && show({ theme: f.dataset.filter }));
      f.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && rest());
    }
    // A hovered card lights its star; the panel keeps its text, since the card already says it all.
    document.addEventListener('work:hover', (e) => {
      const id = (e as CustomEvent<string | null>).detail;
      const star = id ? wstars.find((s) => s.dataset.node === `work:${id}`) : undefined;
      light(star ? { work: star } : pinned ? { theme: pinned } : null);
    });
    document.addEventListener('work:filter', (e) => {
      const theme = (e as CustomEvent<string | null>).detail;
      if (theme !== pinned) sync(theme);
    });

    // Knock the chart's lines out under every label, so no line strikes through a name.
    const svg = atlas.querySelector<SVGSVGElement>('svg.lines');
    const holes = atlas.querySelector<SVGGElement>('[data-ko]');
    const texts = [...atlas.querySelectorAll<HTMLElement>('.tname .full, .tname .short, .tbayer, .bayer, .rad-label, .corner')];
    const faint = [...atlas.querySelectorAll<HTMLElement>('.fstar:not(.fig)')];
    const rayBox = atlas.querySelector<HTMLElement>('[data-rays]');
    function knockout() {
      if (!svg || !holes) return;
      const box = svg.getBoundingClientRect();
      if (!box.width) return;
      const k = svg.viewBox.baseVal.width / box.width;
      const range = document.createRange();
      const rects: string[] = [];
      const boxes: DOMRect[] = [];
      for (const el of texts) {
        range.selectNodeContents(el);
        // A short label carries its full name for screen readers; that text is not on the chart.
        const hidden = el.querySelector('.sr-only');
        if (hidden) range.setEndBefore(hidden);
        for (const r of range.getClientRects()) {
          if (r.width < 3 || r.height < 3) continue;
          boxes.push(r);
          const x = (r.left - box.left - 3) * k;
          const y = (r.top - box.top - 1) * k;
          rects.push(`<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${((r.width + 6) * k).toFixed(1)}" height="${((r.height + 2) * k).toFixed(1)}" rx="${(3 * k).toFixed(1)}"/>`);
        }
      }
      holes.innerHTML = rects.join('');
      // The rays are HTML: cut the same holes with mask layers, the full layer minus every label.
      if (rayBox) {
        const rb = rayBox.getBoundingClientRect();
        const cut = boxes.filter((r) => r.right > rb.left && r.left < rb.right && r.bottom > rb.top && r.top < rb.bottom);
        const px = (n: number) => `${n.toFixed(1)}px`;
        rayBox.style.maskImage = ['linear-gradient(#000 0 0)', ...cut.map(() => 'linear-gradient(#000 0 0)')].join(',');
        rayBox.style.maskSize = ['100% 100%', ...cut.map((r) => `${px(r.width + 6)} ${px(r.height + 2)}`)].join(',');
        rayBox.style.maskPosition = ['0 0', ...cut.map((r) => `${px(r.left - rb.left - 3)} ${px(r.top - rb.top - 1)}`)].join(',');
        rayBox.style.maskRepeat = 'no-repeat';
        rayBox.style.maskComposite = ['subtract', ...cut.map(() => 'add')].join(',');
      }
      // Faint field stars under a label are left out too.
      for (const f of faint) {
        const r = f.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        f.toggleAttribute('data-under', boxes.some((b) => cx > b.left - 4 && cx < b.right + 4 && cy > b.top - 3 && cy < b.bottom + 3));
      }
    }
    if (svg) new ResizeObserver(knockout).observe(svg);
    document.fonts?.ready.then(knockout);

    // The chip rail fades at its right edge only while a chip is cut off there.
    const more = () => {
      const last = filters.at(-1);
      if (!rail || !last) return;
      rail.toggleAttribute('data-more', last.getBoundingClientRect().right > rail.getBoundingClientRect().right - 8);
    };
    if (rail) {
      new ResizeObserver(more).observe(rail);
      rail.addEventListener('scroll', more, { passive: true });
    }
  });
</script>

<style>
  .atlas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17.5rem;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* ---------- the chart plate ---------- */
  .chart {
    position: relative;
    container-type: inline-size;
    border-radius: var(--r-plate);
    corner-shape: var(--corner);
    background:
      radial-gradient(90% 80% at 60% 35%, var(--plate-hi), transparent 70%),
      var(--plate);
    box-shadow:
      var(--edge),
      inset 0 30px 60px -40px var(--plate-inset),
      var(--elev-2);
    overflow: hidden;
    isolation: isolate;
    --rim-angle: 160deg;
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .vg-in {
    stop-color: var(--accent);
    stop-opacity: 0.05;
  }
  .vg-out {
    stop-color: var(--accent);
    stop-opacity: 0;
  }
  .grat path {
    fill: none;
    stroke: color-mix(in oklch, var(--accent-2) 16%, transparent);
    stroke-width: 1;
  }
  .grat .dec {
    stroke-dasharray: 2 5;
  }
  .fig {
    stroke: color-mix(in oklch, var(--text) 26%, transparent);
    stroke-width: 1;
    stroke-linecap: round;
  }
  .fig.lit {
    stroke: color-mix(in oklch, var(--accent) 70%, transparent);
    stroke-width: 1.5;
  }
  .orbit {
    fill: none;
    stroke: color-mix(in oklch, var(--accent) 22%, transparent);
    stroke-width: 1;
    stroke-dasharray: 1 5;
    stroke-linecap: round;
    transition: stroke 0.3s;
  }
  .orbit.lit {
    stroke: color-mix(in oklch, var(--accent) 65%, transparent);
  }
  .also {
    stroke: color-mix(in oklch, var(--accent-2) 50%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    transition: stroke 0.3s;
  }
  .also.lit {
    stroke: var(--accent-2);
  }
  .rad-ring {
    fill: none;
    stroke: color-mix(in oklch, var(--accent) 55%, transparent);
    stroke-width: 1;
  }
  .rad-ring.dashed {
    stroke-dasharray: 2 4;
    stroke: color-mix(in oklch, var(--accent) 35%, transparent);
  }
  .rays {
    position: absolute;
    width: calc(120 * var(--u));
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
  }
  .ray {
    position: absolute;
    left: 50%;
    top: calc(50% - 0.5px);
    width: calc(var(--len) * var(--u));
    height: 1px;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: rotate(var(--a)) translateX(calc(var(--r1) * var(--u)));
    opacity: 0.32;
  }

  /* Draw the figure in when the chart comes into view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) .atlas .fig {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global(:root.js) :global(.is-visible) .atlas .fig,
    :global(:root.js) .atlas:global(.is-visible) .fig {
      animation: draw 1.4s var(--ease-out) both;
      animation-delay: calc(0.3s + var(--i) * 0.22s);
    }
    .ray {
      animation: ray 5.4s var(--ease-out) infinite;
      animation-delay: var(--d);
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ray {
    0%,
    100% {
      opacity: 0.18;
    }
    8% {
      opacity: 0.9;
    }
    30% {
      opacity: 0.18;
    }
  }

  /* ---------- stars ---------- */
  .fstar,
  .wstar,
  .tstar {
    position: absolute;
    translate: -50% -50%;
  }
  .fstar {
    width: var(--s);
    height: var(--s);
  }
  /* The dot is its own layer, so a twinkle never dims the designation beside it. */
  .fstar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: color-mix(in oklch, var(--text) 70%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .fstar::before {
      animation: twinkle 5s ease-in-out infinite;
      animation-delay: var(--tw);
    }
  }
  .fstar[data-under]::before {
    display: none;
  }
  .fstar.fig::before {
    background: color-mix(in oklch, var(--text) 85%, transparent);
    box-shadow: 0 0 calc(var(--s) * 1.5) color-mix(in oklch, var(--text) 35%, transparent);
  }
  .bayer {
    position: absolute;
    left: calc(100% + 0.45rem);
    top: 50%;
    translate: 0 -50%;
    white-space: nowrap;
    font-family: var(--font-mono);
