---
/**
 * The closing frame: a horizon across the page with the radiant rising over it, as the Daytime
 * Arietids' radiant does before dawn. Invitation on the left, address and channels on the right.
 */
import Icon from '~/components/ui/Icon.astro';
import { t, tr, type Locale } from '~/i18n';
import type { Facts } from '~/lib/content';

interface Props {
  lang: Locale;
  facts: Facts;
}
const { lang, facts } = Astro.props;
const _ = t(lang);
const other: Locale = lang === 'zh' ? 'en' : 'zh';
const email = facts.get('contact.email');
const github = facts.get('identity.github');
const open = facts.get('about.open');
// Allow a line break only after the @ on narrow screens.
const [user, domain] = email ? tr(email.text, lang).split('@') : [];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container inner" data-reveal>
    <div class="intro">
      <p class="alt label" lang={other === 'zh' ? 'zh-CN' : 'en'} aria-hidden="true">{t(other)('section.contact')}</p>
      <h2 id="contact-title">{_('section.contact')}</h2>
      {open && <p class="lede" data-visibility={open.visibility}>{tr(open.text, lang)}</p>}
    </div>

    <div class="channels">
      {
        email?.url && (
          <a class="address" href={email.url} aria-label={tr(email.text, lang)} data-visibility={email.visibility}>
            <span class="ping" aria-hidden="true">
              <Icon name="mail" size={22} />
            </span>
            <span class="addr">
              {user}@<wbr />
              {domain}
            </span>
          </a>
        )
      }
      <div class="actions">
        {
          email?.url && (
            <button type="button" class="btn btn-ghost btn-sm" data-copy={tr(email.text, lang)} data-copied-label={_('contact.copied')} data-ping>
              <Icon name="copy" size={15} />
              <span data-copy-label>{_('contact.copy')}</span>
            </button>
          )
        }
        {
          github?.url && (
            <a class="btn btn-ghost btn-sm" href={github.url} target="_blank" rel="me noopener" data-visibility={github.visibility}>
              <Icon name="github" size={16} />
              {tr(github.text, lang)}
              <Icon name="arrow-up-right" size={13} />
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="horizon" aria-hidden="true">
    <div class="glow"></div>
    <div class="sun"></div>
    <svg viewBox="0 0 1600 220" preserveAspectRatio="none" class="arc">
      <path d="M-20 200 Q800 40 1620 200 L1620 240 L-20 240 Z" class="earth"></path>
      <path d="M-20 200 Q800 40 1620 200" class="line" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
</section>

<script>
  import '~/scripts/copy';
  // Copying the address sends one radar ping out from the mail icon.
  document.querySelectorAll<HTMLButtonElement>('[data-ping]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const ping = btn.closest('.contact')?.querySelector<HTMLElement>('.ping');
      if (!ping) return;
      ping.classList.remove('pinging');
      void ping.offsetWidth;
      ping.classList.add('pinging');
    });
  });
</script>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-top: calc(var(--section-gap) / 4);
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: end;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-bottom: clamp(7rem, 14vw, 11rem);
  }
  .intro {
    display: grid;
    gap: 0.6rem;
  }
  .alt {
    color: var(--accent);
  }
  .alt:lang(zh) {
    letter-spacing: 0.3em;
  }
  h2 {
    font-size: var(--step-4);
    line-height: 1;
    font-variation-settings: 'opsz' 144;
  }
  .lede {
    max-width: 30rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .channels {
    display: grid;
    gap: 1rem;
    justify-items: end;
  }
  .address {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 0.9rem + 2.4vw, 2.7rem);
    line-height: 1.15;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .addr {
    background: linear-gradient(to right, var(--accent), var(--accent)) no-repeat 0 100% / 0 1.5px;
    padding-bottom: 0.15rem;
    transition: background-size 0.6s var(--ease-out);
  }
  .address:hover .addr {
    background-size: 100% 1.5px;
  }
  .ping {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    flex: none;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in oklch, var(--accent) 8%, transparent);
    box-shadow: inset 0 0 0 var(--hairline) color-mix(in oklch, var(--accent) 45%, transparent);
  }
  .ping::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--accent);
    opacity: 0;
  }
  .ping:global(.pinging)::after {
    animation: ping 1.1s var(--ease-out);
  }
  @keyframes ping {
    from {
      opacity: 0.9;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ---------- horizon ---------- */
  .horizon {
    position: absolute;
    inset: auto 0 0;
    height: clamp(9rem, 18vw, 15rem);
    z-index: 0;
    pointer-events: none;
  }
  .arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .earth {
    fill: var(--bg-deep);
  }
  .line {
    fill: none;
    stroke: color-mix(in oklch, var(--accent) 55%, transparent);
    stroke-width: 1;
  }
  /* The radiant rising: a gold disc half below the horizon, with a wide warm glow. */
  .sun {
    position: absolute;
    left: 72%;
    bottom: 34%;
    width: clamp(3.5rem, 6vw, 5.5rem);
    aspect-ratio: 1;
    translate: -50% 50%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, var(--accent-fill-hi), var(--accent-fill) 60%, color-mix(in oklch, var(--accent) 60%, transparent));
    box-shadow:
      0 0 40px 10px var(--glow),
      0 0 120px 40px color-mix(in oklch, var(--accent) 16%, transparent);
  }
  .glow {
    position: absolute;
    inset: -60% 0 0;
    background:
      radial-gradient(40% 55% at 72% 70%, color-mix(in oklch, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(70% 60% at 50% 100%, color-mix(in oklch, var(--accent-2) 12%, transparent), transparent 70%);
  }
  :global(:root[data-theme='day']) .glow {
    background: radial-gradient(40% 55% at 72% 70%, color-mix(in oklch, var(--accent-fill) 30%, transparent), transparent 70%);
  }
  :global(:root[data-theme='day']) .sun {
    box-shadow:
      0 0 40px 10px color-mix(in oklch, var(--accent-fill) 45%, transparent),
      0 0 120px 40px color-mix(in oklch, var(--accent-fill) 18%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) .contact .sun {
      translate: -50% 110%;
      transition: translate 2.4s var(--ease-out) 0.3s;
    }
    :global(:root.js) .contact:has(:global(.is-visible)) .sun {
      translate: -50% 50%;
    }
    :global(:root[data-motion='off']) .contact .sun {
      translate: -50% 50%;
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .channels {
      justify-items: start;
    }
  }
  @media (max-width: 30rem) {
    .address {
      font-size: 1.35rem;
      gap: 0.7rem;
    }
    .ping {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
