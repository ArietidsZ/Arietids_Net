---
import Icon from '~/components/ui/Icon.astro';
import Portrait from '~/components/Portrait.astro';
import { t, tr, type Locale } from '~/i18n';
import type { Facts } from '~/lib/content';
import { clauses } from '~/lib/typeset';

interface Props {
  lang: Locale;
  facts: Facts;
  hasWork: boolean;
}
const { lang, facts, hasWork } = Astro.props;
const _ = t(lang);
const other: Locale = lang === 'zh' ? 'en' : 'zh';

const name = facts.get('identity.name')!;
const alias = facts.get('identity.alias');
const tagline = facts.get('hero.tagline');
const github = facts.get('identity.github');
const email = facts.get('contact.email');
const chips = ['education.current', 'education.year', 'location']
  .map((id) => facts.get(id))
  .filter((f) => f !== undefined);

const primary = tr(name.text, lang);
const secondary = tr(name.text, other);
// Chinese names animate per character; Latin names per word.
const parts = lang === 'zh' ? [...primary] : primary.split(' ');
---

<section class="hero" aria-labelledby="hero-name">
  <canvas class="sky" data-sky aria-hidden="true"></canvas>
  <div class="horizon" aria-hidden="true"></div>

  <div class="container grid">
    <div class="copy">
      <p class="eyebrow mono" data-shield>
        <span class="spark" aria-hidden="true"></span>
        {alias && <span data-visibility={alias.visibility}>{tr(alias.text, lang)}</span>}
      </p>

      <h1
        id="hero-name"
        class="name"
        aria-label={secondary !== primary ? `${primary} ${secondary}` : undefined}
        data-shield
        data-visibility={name.visibility} lang={lang === 'zh' ? 'zh-CN' : 'en'}>
        <span class="primary" class:list={[lang]}>
          {
            parts.map((p, i) => (
              <>
                {i > 0 && lang !== 'zh' && ' '}
                <span class="part" style={`--i:${i}`}>{p}</span>
              </>
            ))
          }
        </span>
        {secondary !== primary && ' '}
        {secondary !== primary && <span class="secondary" lang={other === 'zh' ? 'zh-CN' : 'en'}>{secondary}</span>}
      </h1>

      {
        tagline && (
          <p class="tagline" data-shield data-visibility={tagline.visibility}>
            {
              // Chinese wraps between clauses; English wraps naturally.
              lang === 'zh'
                ? clauses(tr(tagline.text, lang)).map((c) => (
                    <>
                      <span class="clause">{c.text}</span>
                      {c.gap}
                    </>
                  ))
                : tr(tagline.text, lang)
            }
          </p>
        )
      }

      {
        chips.length > 0 && (
          <ul class="chips" role="list" data-shield>
            {chips.map((c) => (
              <li data-visibility={c.visibility}>{tr(c.short ?? c.text, lang)}</li>
            ))}
          </ul>
        )
      }

      <div class="cta" data-shield>
        {
          hasWork && (
            <a class="btn btn-primary" href="#work">
              {_('hero.cta.work')}
              <Icon name="arrow-down" size={16} />
            </a>
          )
        }
        {
          github?.url && (
            <a class="btn btn-ghost gh" href={github.url} rel="me noopener" target="_blank" data-visibility={github.visibility}>
              <Icon name="github" size={17} />
              <span class="gh-label">GitHub</span>
            </a>
          )
        }
        {
          email?.url && (
            <a class="btn btn-ghost btn-icon" href={email.url} aria-label={_('contact.email')} data-visibility={email.visibility}>
              <Icon name="mail" size={17} />
            </a>
          )
        }
      </div>
    </div>

    <div class="visual">
      <Portrait lang={lang} />
    </div>
  </div>

  <div class="foot container mono faint" aria-hidden="true">
    <span><span class="radiant-dot"></span>{_('hero.radiant')}</span>
    <span class="scroll">{_('hero.scroll')} <span class="line"></span></span>
  </div>
</section>

<script>
  import { mountSky } from '~/scripts/sky';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-sky]');
  if (canvas) {
    const hero = canvas.closest('.hero');
    const sky = mountSky(canvas, {
      radiant: { x: 0.78, y: 0.4 },
      // The astrolabe is the radiant: meteors burst out from behind it, and the day scope centres on it.
      anchor: hero?.querySelector<HTMLElement>('[data-astrolabe]'),
      shield: [...(hero?.querySelectorAll<HTMLElement>('[data-shield]') ?? [])],
    });
    // Clicking empty sky releases a small burst of meteors.
    canvas.parentElement?.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (!el.closest('a, button')) sky.burst();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, max(40rem, 85vw), 62rem);
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: clip;
  }
  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  :global(:root[data-theme='day']) .horizon {
    background: linear-gradient(to bottom, var(--bg-deep), color-mix(in oklch, var(--bg) 85%, transparent) 72%, transparent);
  }
  /* The hero's own sky fades out at the bottom into the page-wide sky (Cosmos), with no seam. */
  .horizon {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 40% at 10% 55%, var(--accent-2-soft), transparent 70%),
      linear-gradient(to bottom, var(--bg-deep), color-mix(in oklch, var(--bg) 85%, transparent) 72%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 6vh, 4.5rem) 1.5rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    margin-bottom: 1.1rem;
    animation: rise 0.9s var(--ease-out) both;
  }
  .spark {
    width: 1.8rem;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent));
  }

  .name {
    display: grid;
    gap: 0.3em;
    margin-bottom: 1.25rem;
  }
  .primary {
    display: block;
    font-size: clamp(3rem, 1.4rem + 4.2vw + 1.6vh, 8rem);
    line-height: 0.95;
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
  }
  .primary.zh {
    font-family: 'Noto Serif SC Variable', var(--font-display);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .primary.en {
    letter-spacing: -0.03em;
  }
  .part {
    display: inline-block;
    animation: materialize 1.1s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.12s);
  }
  .secondary {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--accent);
    letter-spacing: 0.01em;
    animation: rise 1s var(--ease-out) 0.55s both;
  }
  .secondary:lang(zh) {
    font-style: normal;
    font-family: 'Noto Serif SC Variable', serif;
    letter-spacing: 0.2em;
  }

  .tagline {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.65;
    color: color-mix(in oklch, var(--text) 82%, var(--text-muted));
    animation: rise 1s var(--ease-out) 0.7s both;
  }

  .clause {
    display: inline-block;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    animation: rise 1s var(--ease-out) 0.82s both;
  }
  .chips li {
    padding: 0.25rem 0.75rem;
    text-wrap: balance;
    border: 1px solid var(--line);
    border-radius: 1rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    background: color-mix(in oklch, var(--surface) 60%, transparent);
    backdrop-filter: blur(6px);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    animation: rise 1s var(--ease-out) 0.95s both;
  }
  .visual {
    display: grid;
    place-items: center;
    --size: clamp(15rem, 8rem + 20vw, 36rem);
    animation: emerge 1.4s var(--ease-out) 0.3s both;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem 1.75rem;
    text-transform: none;
    letter-spacing: 0.08em;
  }
  .radiant-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
    vertical-align: 0.1em;
  }
  .scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .line {
    position: relative;
    width: 3rem;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: travel 2.4s var(--ease-in-out) infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes materialize {
    from {
      opacity: 0;
      transform: translateY(0.25em);
      filter: blur(12px);
    }
  }
  @keyframes emerge {
    from {
      opacity: 0;
      transform: scale(0.92);
      filter: blur(8px);
    }
  }
  @keyframes travel {
    from {
      translate: -100% 0;
    }
    to {
      translate: 100% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow,
    .part,
    .secondary,
    .tagline,
    .chips,
    .cta,
    .visual,
    .line::after {
      animation: none;
    }
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
      padding-top: 1.5rem;
      gap: 1rem;
    }
    .visual {
      order: -1;
      justify-self: start;
      width: min(15rem, 62vw);
    }
    .foot > :first-child {
      display: none;
    }
    .foot {
      justify-content: flex-end;
    }
  }
  /* Narrow phones: GitHub becomes an icon button so the actions stay on one row in both languages. */
  @media (max-width: 28rem) {
    .gh {
      width: var(--h);
      padding: 0;
    }
    .gh-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .cta {
      flex-wrap: nowrap;
    }
  }
  /* The very narrowest phones (320px): let the icon buttons drop to a second row. */
  @media (max-width: 22.5rem) {
    .cta {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .cta :global(.btn-primary) {
      padding-inline: 0.95rem;
      gap: 0.4rem;
    }
  }
</style>
