# Canonical origin used for sitemap, canonical URLs and Open Graph.
SITE_URL=https://arietids.net

# public  -> only entries marked `visibility: public` are rendered (default for `astro build`)
# preview -> public + pending entries, with review marks, /review page and noindex (default for `astro dev`)
# npm scripts select the mode explicitly: build -> dist/; build:preview and preview -> out/.
CONTENT_MODE=public
