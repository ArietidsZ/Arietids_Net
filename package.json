{
  "name": "arietids-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal homepage of Zhibo Zhong (Arietids). Static Astro site.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:public": "CONTENT_MODE=public astro dev",
    "build": "node scripts/visibility.mjs lint && CONTENT_MODE=public astro build && node scripts/check-public.mjs && node scripts/fonts.mjs --check",
    "build:preview": "node scripts/visibility.mjs lint && CONTENT_MODE=preview astro build",
    "preview": "CONTENT_MODE=preview astro preview",
    "preview:public": "CONTENT_MODE=public astro preview",
    "check": "astro check && node scripts/visibility.mjs lint",
    "review": "node scripts/visibility.mjs list",
    "visibility": "node scripts/visibility.mjs",
    "og": "node scripts/og.mjs",
    "fonts": "node scripts/fonts.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:public": "playwright test -c playwright.public.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "fontverter": "2.0.0",
    "harfbuzzjs": "1.6.4",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
